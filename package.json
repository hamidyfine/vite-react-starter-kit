{
  "name": "react-starter-kit",
  "description": "React Starter Template with Vite, TypeScript, i18next, Jest, Testing-Library, and ESLint. A streamlined setup with best practices for folder structure and configuration. Ideal for scalable React apps",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "author": {
    "name": "Hamid Yaftian",
    "email": "hamid.yaftian@gmail.com",
    "url": "https://github.com/hamidyfine"
  },
  "repository": {
    "url": "https://github.com/hamidyfine/react-starter-kit"
  },
  "scripts": {
    "dev": "vite --open --port 4005",
    "build": "tsc -b && vite build",
    "lint": "npm run lint:scripts && npm run lint:styles",
    "lint:scripts": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:styles": "stylelint src/**/*.scss",
    "preview": "vite preview",
    "commit": "cz",
    "prepare": "husky",
    "bundle-analyzer": "npx bundlesize",
    "bundle-analyzer:visual": "npx vite-bundle-visualizer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "release": "npm run lint && npm run test && release-it"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@mantine/core": "^7.17.2",
    "@mantine/dates": "^7.17.2",
    "@mantine/hooks": "^7.17.2",
    "@mantine/modals": "^7.17.2",
    "@mantine/notifications": "^7.17.2",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-query-devtools": "^5.69.0",
    "concurrently": "^9.1.2",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.3",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.483.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@stylistic/eslint-plugin-migrate": "^4.2.0",
    "@tanstack/eslint-plugin-query": "^5.68.0",
    "@tanstack/eslint-plugin-router": "^1.114.12",
    "@tanstack/react-router": "^1.114.25",
    "@tanstack/react-router-devtools": "^1.114.25",
    "@tanstack/router-devtools": "^1.114.25",
    "@tanstack/router-plugin": "^1.114.25",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/ui": "^3.0.9",
    "commitizen": "^4.3.1",
    "core-js": "^3.41.0",
    "cz-customizable": "^7.4.0",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^4.2.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsdoc": "^50.6.8",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-perfectionist": "^4.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.6.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-tsdoc": "^0.4.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "release-it": "^18.1.2",
    "sass-embedded": "^1.86.0",
    "stylelint": "^16.16.0",
    "stylelint-config-hudochenkov": "^11.0.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.11.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vite-plugin-bundlesize": "^0.1.0",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:scripts"
    ],
    "*.{css,scss}": [
      "npm run lint:styles"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
